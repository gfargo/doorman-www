# This is an example of your .env file format.
# Note: this must be .env, not .env.local, without further configuration changes.

# Optional — the canonical site URL used in metadata/sitemap/robots.
# Falls back to https://doorman.griffen.codes if unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Required by the `firewall:list`/`firewall:download`/`firewall:sync` npm
# scripts, which shell out to the `doorman` CLI against this site's own
# Vercel Firewall config.
VERCEL_TOKEN=***
VERCEL_PROJECT_ID=***
VERCEL_TEAM_ID=***